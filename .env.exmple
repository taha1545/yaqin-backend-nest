# app
NODE_ENV=development
PORT=3000
APP_NAME=Yaqin

# db
DATABASE_URL=postgresql://taha:taha2005@localhost:5432/taha_db?schema=public

# jwt
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Bcrypt
BCRYPT_ROUNDS=10

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5

# OTP
OTP_EXPIRES_IN_MINUTES=10

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Redis
REDIS_URL=

# Mail 
RESEND_API_KEY=
MAIL_FROM=

# S3 
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_EXPIRES_IN=3600
S3_ENDPOINT=
S3_PUBLIC_URL=

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Seed admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
